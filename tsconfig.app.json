{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2024",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["vite/client"],
    "paths": {
      "#/*": ["./src/*"],
      "#/api/*": ["./generated/api/*"]
    }
  },
  "include": ["src", "generated"]
}
